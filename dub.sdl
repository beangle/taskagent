name "beangle-task"
description "Beangle Task"
authors "chaostone"
license "GPLv3"
version "0.0.2"

dependency "dxml" version="~>0.4.5"
dependency "vibe-inet" version="~>1.3.0"
dependency "vibe-http" version="~>1.5.0"
dependency "vibe-stream:tls" version="~>1.4.0"
subConfiguration "vibe-stream:tls" "notls"

targetType "executable"
targetName "beangle-task"
targetPath "target"

mainSourceFile "source/app.d"
versions "EventCoreSilenceLeakWarnings" "VibeDisableCommandLineParsing"
toolchainRequirements dub=">=1.34.0" frontend=">=2.102.0" ldc=">=1.32.0"
